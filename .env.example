# Copy to .env for `docker compose up`. Demo values only: change them, and
# never point this at a real firm's data.

# Only with compose.build.yml (building the portal from source): where you
# cloned the Dhvaj Portal, branch switch-integration.
DHVAJ_PORTAL_DIR=../dhvaj-portal

# Host ports. The prebuilt web image calls the API at localhost:3101, so keep
# API_PORT at 3101 unless you build the images yourself.
API_PORT=3101
WEB_PORT=3100
DB_PORT=5434

# Database: the superuser bootstraps; the app runs as hsdg_app, migrations as hsdg_migrator.
POSTGRES_PASSWORD=postgres
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_APP_PASSWORD=change-me-app

# Signs portal sessions (32+ characters).
AUTH_JWT_SECRET=change-me-to-a-long-random-string-for-the-demo

# Lets the bridge run the portal's scheduled jobs locally (reminders, outbox). 16+ characters.
CRON_SECRET=change-me-cron-secret

# ── Host side: dhvaj-mcp, the agents and the bridge ─────────────────────────
# Read by npm scripts on your machine (export them, or prefix the command).
#   DHVAJ_API_URL=http://localhost:3101/api/v1
#   DHVAJ_WEB_URL=http://localhost:3100
#   DHVAJ_CRON_SECRET=<same as CRON_SECRET>
#
# Switch: with Switch Console's local server nothing is needed. For another
# server set SWITCH_URL, SWITCH_EMAIL and SWITCH_PASSWORD.
